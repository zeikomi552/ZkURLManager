<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.3.0" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <!-- Material Design in XAML (official) -->
    <!--
      本格的な MaterialDesign を導入する場合は以下のパッケージを追加してください。
      例:
        <PackageReference Include="MaterialDesignThemes" Version="4.2.1" />
        <PackageReference Include="MaterialDesignColors" Version="2.2.2" />
      今回は簡易的なテーマを用意したため外部パッケージは追加していません。
    -->
  </ItemGroup>

</Project>
