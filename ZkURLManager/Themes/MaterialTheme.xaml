<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Simple material-like style definitions.
    Provides basic styles for Button, TextBox and DataGrid
    without adding external MaterialDesign libraries.
  -->

  <!-- Color palette -->
  <Color x:Key="MaterialPrimaryColor">#6200EE</Color>
  <Color x:Key="MaterialPrimaryDarkColor">#3700B3</Color>
  <Color x:Key="MaterialBackgroundColor">#FAFAFA</Color>
  <Color x:Key="MaterialSurfaceColor">#FFFFFF</Color>
  <Color x:Key="MaterialOnPrimaryColor">#FFFFFF</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource MaterialPrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource MaterialPrimaryDarkColor}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource MaterialBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource MaterialSurfaceColor}" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource MaterialOnPrimaryColor}" />

  <!-- Window background -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>

  <!-- Basic button style (material-like flat raised button) -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TextBox style (flat with focus border) -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#FFBDBDBD" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Simple DataGrid style -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="RowBackground" Value="White" />
    <Setter Property="AlternatingRowBackground" Value="#FFF7F7F7" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <!-- TextBlock style for headings -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="Black" />
  </Style>

</ResourceDictionary>
